{
  "name": "maglucen-stardew-valley-companion",
  "version": "1.11.1",
  "description": "Maglucen's local, save-aware companion for Stardew Valley.",
  "author": "maglucen",
  "main": "desktop/main.mjs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "npm run verify:changelog && vinext build && node scripts/prepare-built-public.mjs",
    "start": "vinext start",
    "test": "npm run verify:localization && npm run build && node --test tests/rendered-html.test.mjs tests/localization.test.mjs tests/changelog.test.mjs tests/release-notes.test.mjs tests/production-engine.test.mjs tests/forestry-engine.test.mjs tests/machine-engine.test.mjs tests/animal-engine.test.mjs tests/pond-engine.test.mjs tests/portfolio-engine.test.mjs tests/local-package.test.mjs",
    "verify:changelog": "node scripts/verify-changelog.mjs",
    "verify:localization": "node scripts/verify-localization-ui.mjs",
    "verify:public": "node scripts/verify-public-safety.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .local --ignore-pattern outputs --ignore-pattern release",
    "electron:prepare": "node node_modules/electron/install.js",
    "postinstall": "npm run electron:prepare",
    "desktop:bridge": "node scripts/prepare-bridge.mjs",
    "desktop:game-data": "node scripts/prepare-game-data-extractor.mjs",
    "desktop": "npm run desktop:bridge && npm run desktop:game-data && npm run build && npm run electron:prepare && electron .",
    "desktop:dev": "npm run desktop:bridge && npm run desktop:game-data && node scripts/prepare-portable-python.mjs && npm run electron:prepare && node scripts/desktop-development.mjs",
    "desktop:dist": "npm run desktop:installer",
    "desktop:installer": "npm run desktop:bridge && npm run desktop:game-data && npm run build && node scripts/prepare-portable-python.mjs && npm run electron:prepare && electron-builder --win nsis --publish never",
    "desktop:portable": "npm run desktop:bridge && npm run desktop:game-data && npm run build && node scripts/prepare-portable-python.mjs && npm run electron:prepare && electron-builder --win portable",
    "desktop:dir": "npm run desktop:bridge && npm run desktop:game-data && npm run build && node scripts/prepare-portable-python.mjs && npm run electron:prepare && electron-builder --win dir",
    "local:verify": "node scripts/local-package.mjs verify",
    "local:unpacked": "node scripts/local-package.mjs unpacked",
    "local:installer": "node scripts/local-package.mjs installer"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "json5": "^2.2.3",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xnb": "^1.3.0-a"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2"
  },
  "type": "module",
  "build": {
    "appId": "io.github.maglucenstudio.stardewvalleycompanion",
    "productName": "Maglucen Stardew Valley Companion",
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "scripts/**",
      "assetbuild/**",
      "desktop/resources/**",
      "bridge/**",
      "node_modules/**"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "es"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/assets/**",
      "!dist/data/**",
      "!dist/client/assets/**",
      "!dist/client/data/**",
      "desktop/**",
      "locales/**",
      "!desktop/resources/python/**",
      "scripts/**",
      "bridge/StardewValleyToolBridge/manifest.json",
      "public/favicon.png",
      "public/app-icon.png",
      "vite.config.ts",
      "next.config.ts",
      "package.json",
      "!scripts/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "desktop/resources/python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "MaglucenStardewValleyCompanion",
      "icon": "desktop/resources/icon.ico"
    },
    "nsis": {
      "artifactName": "Maglucen-Stardew-Valley-Companion-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maglucen Stardew Valley Companion",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Maglucen-Stardew-Valley-Companion-Portable-${version}.${ext}",
      "unpackDirName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Maglucen-Studio",
        "repo": "StardewValleyTool",
        "releaseType": "release"
      }
    ]
  }
}
