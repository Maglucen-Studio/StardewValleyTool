# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# machine-specific Stardew configuration and player data
/config.local.json
/public/data/*.json
/public/data/days/
!/public/data/.gitkeep

# copyrighted assets extracted from the user's own Stardew installation
/public/assets/*
/assetbuild/packed/
/assetbuild/unpacked/*
/assetbuild/storage-location-maps/
/assetbuild/game-data.json
/assetbuild/content-patcher-catalog.json
!/public/assets/.gitkeep
!/assetbuild/unpacked/.gitkeep

# vercel
.vercel

/dist/
/release/
/.wrangler/
/outputs/
/work/

# locally unpacked Stardew source assets (the app uses public/assets/sprites)
/assetbuild/data-packed/
/assetbuild/data-unpacked/
/assetbuild/dynamic-packed/
/assetbuild/dynamic-unpacked/
/assetbuild/achievement-packed/
/assetbuild/achievement-unpacked/
/assetbuild/game-data.json
/watcher.log
/.cache/
/recovery/
__pycache__/
*.tsbuildinfo
/bridge/**/bin/
/bridge/**/obj/
/bridge/**/publish/
/tools/**/bin/
/tools/**/obj/
/tools/**/publish/
/desktop/resources/game-data-extractor/
/desktop/resources/bridge/*.pdb
/desktop/resources/python/
/desktop/resources/bridge/*.dll
/.stardew-reference-assemblies/
*.user
*.suo

# local launcher/runtime state
/.local/
/logs/
*.pid
*.tmp
